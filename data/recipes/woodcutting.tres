[gd_resource type="Resource" script_class="RecipeDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://src/defs/recipe_def.gd" id="1_recipe"]
[ext_resource type="Script" path="res://src/defs/steps/go_to_step_def.gd" id="2_goto"]
[ext_resource type="Script" path="res://src/defs/steps/work_step_def.gd" id="3_work"]
[ext_resource type="Script" path="res://src/defs/steps/gather_step_def.gd" id="4_gather"]
[ext_resource type="Script" path="res://src/defs/steps/deliver_step_def.gd" id="5_deliver"]
[ext_resource type="Script" path="res://src/defs/steps/step_def.gd" id="6_stepdef"]

[sub_resource type="Resource" id="goto_tree"]
script = ExtResource("2_goto")
target = &"resource"
resource = &"tree"

[sub_resource type="Resource" id="chop"]
script = ExtResource("3_work")
activity = &"chop"
duration = 4.0

[sub_resource type="Resource" id="gather"]
script = ExtResource("4_gather")

[sub_resource type="Resource" id="bind"]
script = ExtResource("3_work")
activity = &"bind"
duration = 2.0

[sub_resource type="Resource" id="deliver"]
script = ExtResource("5_deliver")

[resource]
script = ExtResource("1_recipe")
steps = Array[ExtResource("6_stepdef")]([SubResource("goto_tree"), SubResource("chop"), SubResource("gather"), SubResource("bind"), SubResource("deliver")])
id = &"woodcutting"
