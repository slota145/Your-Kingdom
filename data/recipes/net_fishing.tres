[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://src/defs/recipe_def.gd" id="1_recipe"]
[ext_resource type="Script" path="res://src/defs/steps/go_to_step_def.gd" id="3_goto"]
[ext_resource type="Script" path="res://src/defs/steps/work_step_def.gd" id="4_work"]
[ext_resource type="Script" path="res://src/defs/steps/deliver_step_def.gd" id="6_deliver"]
[ext_resource type="Script" path="res://src/defs/steps/step_def.gd" id="7_stepdef"]
[ext_resource type="Script" path="res://src/defs/steps/gather_step_def.gd" id="8_gather"]
[ext_resource type="Script" path="res://src/defs/steps/sail_step_def.gd" id="9_sail"]

[sub_resource type="Resource" id="go_home"]
script = ExtResource("3_goto")
target = &"workplace"

[sub_resource type="Resource" id="sail_out"]
script = ExtResource("9_sail")
target = &"shoal"
resource = &"fish_shoal"

[sub_resource type="Resource" id="cast"]
script = ExtResource("4_work")
activity = &"cast_net"
duration = 4.0

[sub_resource type="Resource" id="wait"]
script = ExtResource("4_work")
activity = &"wait_net"
duration = 12.0

[sub_resource type="Resource" id="haul"]
script = ExtResource("4_work")
activity = &"haul_net"
duration = 4.0

[sub_resource type="Resource" id="gather"]
script = ExtResource("8_gather")

[sub_resource type="Resource" id="sail_back"]
script = ExtResource("9_sail")
target = &"home"

[sub_resource type="Resource" id="deliver"]
script = ExtResource("6_deliver")

[resource]
script = ExtResource("1_recipe")
steps = Array[ExtResource("7_stepdef")]([SubResource("go_home"), SubResource("sail_out"), SubResource("cast"), SubResource("wait"), SubResource("haul"), SubResource("gather"), SubResource("sail_back"), SubResource("deliver")])
id = &"net_fishing"
