[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://src/defs/recipe_def.gd" id="1_recipe"]
[ext_resource type="Script" path="res://src/defs/steps/step_def.gd" id="7_stepdef"]
[ext_resource type="Script" path="res://src/defs/steps/fetch_step_def.gd" id="2_fetch"]
[ext_resource type="Script" path="res://src/defs/steps/go_to_step_def.gd" id="3_goto"]
[ext_resource type="Script" path="res://src/defs/steps/work_step_def.gd" id="4_work"]
[ext_resource type="Script" path="res://src/defs/steps/produce_step_def.gd" id="5_produce"]
[ext_resource type="Script" path="res://src/defs/steps/deliver_step_def.gd" id="6_deliver"]

[sub_resource type="Resource" id="fetch_0"]
script = ExtResource("2_fetch")
good = &"iron"
amount = 1

[sub_resource type="Resource" id="goto_1"]
script = ExtResource("3_goto")
target = &"workplace"

[sub_resource type="Resource" id="work_2"]
script = ExtResource("4_work")
activity = &"heat"
duration = 10.0
spot = &"forge"

[sub_resource type="Resource" id="work_3"]
script = ExtResource("4_work")
activity = &"forge"
duration = 28.0
spot = &"anvil"

[sub_resource type="Resource" id="work_4"]
script = ExtResource("4_work")
activity = &"quench"
duration = 7.0
spot = &"anvil"

[sub_resource type="Resource" id="produce_5"]
script = ExtResource("5_produce")
output = &"morning_star"
amount = 1

[sub_resource type="Resource" id="deliver_6"]
script = ExtResource("6_deliver")

[resource]
script = ExtResource("1_recipe")
steps = Array[ExtResource("7_stepdef")]([SubResource("fetch_0"), SubResource("goto_1"), SubResource("work_2"), SubResource("work_3"), SubResource("work_4"), SubResource("produce_5"), SubResource("deliver_6")])
id = &"forging_morning_stars"
