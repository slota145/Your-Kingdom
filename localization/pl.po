msgid "recipe.charcoal_making.desc"
msgstr "2 drewna → 1 węgiel drzewny (ok. 40 s)."

msgid "recipe.mining.name"
msgstr "Wydobycie rudy"

msgid "recipe.mining.desc"
msgstr "Górnik wykuwa 1 rudę z żyły (ok. 45 s z drogą)."

msgid "recipe.smelting.name"
msgstr "Wytop żelaza"

msgid "recipe.smelting.desc"
msgstr "1 ruda + 1 węgiel → 1 żelazo (ok. 40 s)."

msgid "recipe.forging_spears.name"
msgstr "Kucie włóczni"

msgid "recipe.forging_spears.desc"
msgstr "1 żelazo + 1 deska → 2 włócznie (ok. 45 s)."

msgid "recipe.forging_swords.name"
msgstr "Kucie mieczy"

msgid "recipe.forging_swords.desc"
