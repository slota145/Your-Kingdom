# N1: quays and moorings

msgid "ui.build.pier"
msgstr "Pomost"

msgid "ui.build.pier_tip"
msgstr "Drewniany pomost na morzu: 2 deski na kafel. Przeciągnij myszą od brzegu w głąb morza (najwyżej 8 kafli), jak mur: prosto albo po skosie, w 8 kierunkach (skos zajmuje więcej kafli); może też wejść na ląd na 2 kafle. Rzędy obok siebie łączą się w jedno szerokie nabrzeże. Ludzie po nim chodzą, statki nie przepływają. Na pomoście stawiasz port, stocznię, przystań i miejsce cumowania."

msgid "ui.build.stone_quay"
msgstr "Nabrzeże"

msgid "ui.build.stone_quay_tip"
msgstr "Kamienne nabrzeże: 3 kamienie na kafel. Działa jak pomost, ale ludzie chodzą po nim szybciej, jak po bruku."

msgid "ui.doing.quay"
msgstr "na nabrzeże"

msgid "building.mooring.name"
msgstr "Miejsce cumowania"

msgid "building.mooring.desc"
msgstr "Pachołki i liny na krawędzi nabrzeża: przybija tu jeszcze jeden statek. Nie ma własnych ludzi: towar noszą portowcy z portu w odległości do 12 kafli. Stawiaj na pomoście albo nabrzeżu, przodem do wody."

msgid "ui.command_error.not_on_quay"
msgstr "Na nabrzeżu stoją tylko budynki portowe."

msgid "ui.command_error.needs_quay"
msgstr "Tu potrzebne jest nabrzeże albo pomost pod budynkiem (na palach stoi najwyżej tyle rzędów, ile pozwala budynek)."

msgid "ui.command_error.no_port_nearby"
msgstr "W pobliżu (do 12 kafli) nie ma portu, którego portowcy obsłużą statek."

msgid "ui.command_error.already_quay"
msgstr "Tu już jest nabrzeże."

msgid "ui.command_error.keeps_fairway"
msgstr "Tędy statki dopływają do głębokiej wody."

msgid "ui.command_error.keeps_berth"
msgstr "Tu cumują statki."

msgid "ui.command_error.too_far_from_shore"
msgstr "Za daleko od brzegu (najwyżej 8 kafli)."

msgid "ui.command_error.not_at_shore"
msgstr "Nabrzeże musi zaczynać się przy brzegu albo przy innym nabrzeżu."

msgid "ui.command_error.blocks_sea"
msgstr "To nabrzeże odcięłoby od morza statek, miejsce cumowania albo ławicę ryb."

msgid "ui.command_error.no_quay"
msgstr "Tu nie ma nabrzeża."

msgid "ui.command_error.cuts_quay"
msgstr "Reszta nabrzeża straciłaby połączenie z brzegiem."

msgid "ui.command_error.bad_quay"
msgstr "Nieznany rodzaj nabrzeża."

msgid "ui.command_error.too_far_from_sea"
msgstr "Za daleko od morza: nabrzeże wchodzi na ląd najwyżej na 2 kafle."

# N1 part 2: the cargo crane and the port warehouse

msgid "building.crane.name"
msgstr "Dźwig portowy"

msgid "building.crane.desc"
msgstr "Drewniany dźwig z kołem deptakowym. Dźwigowy chodzi w kole i przenosi po 3 sztuki naraz między placem a statkiem przy miejscu cumowania, obok portowców, więc statek ładuje się dużo szybciej. Stawiaj na nabrzeżu, najwyżej 2 kafle od miejsca, gdzie cumuje statek (przy porcie albo miejscu cumowania)."

msgid "building.port_warehouse.name"
msgstr "Magazyn portowy"

msgid "building.port_warehouse.desc"
msgstr "Duży magazyn na nabrzeżu, tuż przy statkach: 8 miejsc na towary. Nie ma własnej obsługi: towar noszą portowcy i tragarze. Stąd idzie towar na statki przy słupkach. Może stać 2 rzędami na palach nad wodą."

msgid "ui.kind.crane_operator"
msgstr "Dźwigowy"

msgid "ui.reason.no_berth"
msgstr "dźwig nie stoi przy żadnym miejscu cumowania"

msgid "ui.command_error.no_berth_nearby"
msgstr "Dźwig musi stać najwyżej 2 kafle od miejsca, gdzie cumuje statek (przy porcie albo miejscu cumowania)."

msgid "recipe.crane_work.name"
msgstr "Przeładunek dźwigiem"

msgid "recipe.crane_work.desc"
msgstr "Dźwigowy chodzi w kole deptakowym i przenosi po 3 sztuki między placem a statkiem."

msgid "ui.crane.no_berth"
msgstr "Nie stoi przy żadnym miejscu cumowania."

msgid "ui.crane.serves"
msgstr "Obsługuje: %s"

msgid "ui.crane.no_ship"
msgstr "Czeka na statek"

msgid "ui.crane.lifting"
msgstr "Podnosi: %s"

msgid "ui.reason.no_ship"
msgstr "przy nabrzeżu nie ma statku"

msgid "ui.reason.no_cargo"
msgstr "nie ma nic do przeniesienia"

# --- M7 part 1: metals, weapons, barracks ---

msgid "good.charcoal.name"
msgstr "Węgiel drzewny"

msgid "good.charcoal.desc"
msgstr "Czarne, lekkie bryłki z wypalonego drewna. Daje żar, jakiego potrzebuje huta."

msgid "good.iron_ore.name"
msgstr "Ruda żelaza"

msgid "good.iron_ore.desc"
msgstr "Rdzawe bryły skały wykute z żyły rudy. W hucie stają się żelazem."

msgid "good.iron.name"
msgstr "Żelazo"

msgid "good.iron.desc"
msgstr "Sztaby żelaza z huty. Z nich kowal kuje broń, a płatnerz zbroje."

msgid "good.spear.name"
msgstr "Włócznia"

msgid "good.spear.desc"
msgstr "Długie drzewce z żelaznym grotem. Broń włócznika, groźna dla jeźdźców."

msgid "good.bow.name"
msgstr "Łuk"

msgid "good.bow.desc"
msgstr "Łuk z giętkiego drewna, z cięciwą. Broń łucznika."

msgid "good.sword.name"
msgstr "Miecz"

msgid "good.sword.desc"
msgstr "Prosty miecz z żelaza. Broń miecznika i jeźdźca."

msgid "good.chainmail.name"
msgstr "Zbroja"

msgid "good.chainmail.desc"
msgstr "Zbroja z żelaza: kolczuga z płytami na piersi i ramionach. Chroni miecznika, jeźdźca, halabardnika i ciężkiego zbrojnego."

msgid "good.horse.name"
msgstr "Koń"

msgid "good.horse.desc"
msgstr "Koń wierzchowy ze stadniny. Bez niego nie ma jeźdźca."

msgid "building.charcoal_burner.name"
msgstr "Węglarz"

msgid "building.charcoal_burner.desc"
msgstr "Węglarz układa drewno w mielerz, przykrywa go darnią i pali powoli przez wiele godzin. Z 2 drewien robi worek węgla."

msgid "building.mine.name"
msgstr "Kopalnia rudy"

msgid "building.mine.desc"
msgstr "Górnik wykuwa rudę żelaza z pobliskiej żyły i nosi ją do magazynu. Stawiaj przy żyle rudy w skałach."

msgid "building.smelter.name"
msgstr "Huta"

msgid "building.smelter.desc"
msgstr "Hutnik sypie rudę i węgiel do pieca, dmie miechami i wytapia sztabę żelaza."

msgid "building.blacksmith.name"
msgstr "Kowal"

msgid "building.blacksmith.desc"
msgstr "Kowal rozgrzewa żelazo w palenisku i kuje na kowadle: z żelaza i deski 2 włócznie albo z żelaza miecz. W panelu wybierasz, co ma kuć."

msgid "building.armourer.name"
msgstr "Płatnerz"

msgid "building.armourer.desc"
msgstr "Płatnerz kuje zbroję z 2 sztab żelaza: splata kółka i nitowane płyty."

msgid "building.bowyer.name"
msgstr "Łuczarz"

msgid "building.bowyer.desc"
msgstr "Łuczarz struga łęczysko z 2 desek, wygina je i nakłada cięciwę."

msgid "building.stud_farm.name"
msgstr "Stadnina"

msgid "building.stud_farm.desc"
msgstr "Stajenny karmi i czesze konie, a stado samo się powiększa. Na start para koni. Tylko w prowincji z pastwiskami koni."

msgid "building.armoury.name"
msgstr "Zbrojownia"

msgid "building.armoury.desc"
msgstr "Tu trafia cała broń i zbroje. Rekruci przychodzą tu po swój ekwipunek."

msgid "building.barracks.name"
msgstr "Koszary"

msgid "building.barracks.desc"
msgstr "Dom żołnierzy: 24 łóżka. Tu rekrutujesz wojsko. Żołnierze jedzą z magazynu i ćwiczą na placu przed koszarami."

msgid "recipe.charcoal_making.name"
