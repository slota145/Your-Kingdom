msgid "ship.carrack_war.desc"
msgstr "Karaka z tarczami: wiezie 60 żołnierzy, mocny kadłub i dużo bełtów. Koszt: 54 deski, 14 beczek smoły, 12 bel sukna, 8 żelaza."

msgid "ship.galleon.name"
msgstr "Galeon"

msgid "ship.galleon.desc"
msgstr "Największy: cztery maszty, po trzy żagle na przednich, wysoki tylny kasztel, furty na burtach. Ładownia 12 pól. Koszt: 70 desek, 18 beczek smoły, 18 bel sukna, 6 żelaza."

msgid "ship.galleon_war.name"
