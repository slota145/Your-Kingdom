# --- Buildings ---

msgid "building.woodcutter.name"
msgstr "Drwal"

msgid "building.woodcutter.desc"
msgstr "Drwal ścina drzewa w okolicy i odnosi kłody do magazynu."

msgid "building.bakery.name"
msgstr "Piekarnia"

msgid "building.bakery.desc"
msgstr "Piekarz przynosi mąkę, zagniata ciasto i wypieka chleb w piecu."

msgid "building.stockpile.name"
msgstr "Magazyn"

msgid "building.stockpile.desc"
msgstr "Plac składowy. Towary leżą tu w stosach, a tragarze je przynoszą i zabierają."

# --- Recipes ---

msgid "recipe.woodcutting.name"
msgstr "Wyrąb drewna"

msgid "recipe.woodcutting.desc"
msgstr "Drwal idzie do drzewa, rąbie je, wiąże kłodę i niesie ją do magazynu."

