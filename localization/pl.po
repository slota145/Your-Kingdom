# --- M4a ---

msgid "good.planks.name"
msgstr "Deski"

msgid "good.planks.desc"
msgstr "Deski z tartaku. Potrzebne do awansu chat i większych budowli."

msgid "good.stone.name"
msgstr "Kamień"

msgid "good.stone.desc"
msgstr "Ciosany kamień z kamieniołomu. Budulec kościoła i browaru."

msgid "good.fish.name"
msgstr "Ryby"

msgid "good.fish.desc"
msgstr "Ryby złowione wędką w rzece. Jedzą je chłopi i mieszczanie."

msgid "good.hops.name"
msgstr "Chmiel"

msgid "good.hops.desc"
msgstr "Szyszki chmielu z chmielnika. Bez nich nie ma piwa."

msgid "good.beer.name"
msgstr "Piwo"

msgid "good.beer.desc"
msgstr "Piwo z browaru, warzone ze zboża i chmielu. Mieszczanie bez niego nie wytrzymają."

msgid "building.sawmill.name"
msgstr "Tartak"

msgid "building.sawmill.desc"
msgstr "Tracz przynosi kłodę z magazynu, przecina ją na deski i odnosi je."

msgid "building.quarry.name"
msgstr "Kamieniołom"

msgid "building.quarry.desc"
msgstr "Kamieniarz odłupuje kamień ze skał w okolicy i odnosi go do magazynu."

msgid "building.fishing_hut.name"
msgstr "Chata wędkarza"

msgid "building.fishing_hut.desc"
msgstr "Wędkarz idzie nad wodę, zarzuca wędkę i czeka na branie. Stawiaj blisko rzeki."

msgid "building.hop_farm.name"
msgstr "Chmielnik"

msgid "building.hop_farm.desc"
msgstr "Chmielarz uprawia chmiel na polach wokół zagrody. Pola stawiasz sam, jak przy farmie."

msgid "building.brewery.name"
msgstr "Browar"

msgid "building.brewery.desc"
msgstr "Piwowar przynosi zboże i chmiel, zaciera, warzy i odnosi beczki piwa."

msgid "building.chapel.name"
msgstr "Kaplica"

msgid "building.chapel.desc"
msgstr "Mała kaplica. Chłopi w jej zasięgu są bardziej zadowoleni."

msgid "building.church.name"
msgstr "Kościół"

msgid "building.church.desc"
msgstr "Kamienny kościół z wieżą. Mieszczanie w jego zasięgu są bardziej zadowoleni."

msgid "building.market.name"
msgstr "Targowisko"

msgid "building.market.desc"
msgstr "Plac z kramami. Straganiarze przynoszą z magazynów jedzenie, napitki, ubrania i opał. Domy w zasięgu kupują tutaj i są bardziej zadowolone. Tu staje kupiec wędrowny."

msgid "resource_node.rock.name"
msgstr "Skała"

msgid "resource_node.rock.desc"
msgstr "Wychodnia skalna. Kamieniarz odłupuje z niej kamień, aż zostanie gruz."

msgid "need.bread.name"
msgstr "Chleb"

msgid "need.bread.desc"
msgstr "Mieszczanie chcą codziennie chleba."

msgid "need.fish_or_meat.name"
msgstr "Ryby lub mięso"

msgid "need.fish_or_meat.desc"
msgstr "Mieszczanie chcą też ryb (mięso dojdzie później)."

msgid "need.beer.name"
msgstr "Piwo"

msgid "need.beer.desc"
msgstr "Mieszczanie piją piwo z browaru."

msgid "need.chapel.name"
msgstr "Kaplica"

