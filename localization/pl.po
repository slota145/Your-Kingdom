# --- Buildings ---

msgid "building.woodcutter.name"
msgstr "Drwal"

msgid "building.woodcutter.desc"
msgstr "Drwal ścina drzewa w okolicy i odnosi kłody do magazynu."

msgid "building.bakery.name"
msgstr "Piekarnia"

msgid "building.bakery.desc"
msgstr "Piekarz przynosi mąkę, zagniata ciasto i wypieka chleb w piecu."

msgid "building.stockpile.name"
msgstr "Magazyn"

msgid "building.stockpile.desc"
msgstr "Plac składowy. Towary leżą tu w stosach, a tragarze je przynoszą i zabierają."

msgid "building.porters_hut.name"
msgstr "Chata tragarzy"

msgid "building.porters_hut.desc"
msgstr "Mała chata 4 tragarzy. Noszą towary w całej prowincji, tak jak tragarze magazynów. Można jej kupić 2 wózki."

msgid "building.porters_house.name"
msgstr "Dom tragarzy"

msgid "building.porters_house.desc"
msgstr "Duży dom 6 tragarzy. Noszą towary w całej prowincji, tak jak tragarze magazynów. Można mu kupić 3 wózki."

# --- Recipes ---

msgid "recipe.woodcutting.name"
msgstr "Wyrąb drewna"

msgid "recipe.woodcutting.desc"
msgstr "Drwal idzie do drzewa, rąbie je, wiąże kłodę i niesie ją do magazynu."

# --- Resource nodes ---

msgid "resource_node.tree.name"
msgstr "Drzewo"

msgid "resource_node.tree.desc"
msgstr "Daje kilka kłód drewna. Po ścięciu zostaje pniak."

# --- UI: stockpile panel ---

msgid "ui.stockpile.title"
msgstr "Magazyn"

msgid "ui.stockpile.empty"
msgstr "Pusto"

# --- M3: buildings, terrain, needs, houses ---

msgid "building.town_hall.name"
msgstr "Ratusz"

msgid "building.town_hall.desc"
msgstr "Serce osady. Mieszkają tu tragarze i budowniczy, którzy noszą towary i stawiają budynki."

msgid "building.hut.name"
msgstr "Chata"

msgid "building.hut.desc"
msgstr "Dom dla 4 chłopów. Zaopatrzony w chleb, drewno i wodę ze studni awansuje na dom mieszczański."

msgid "building.well.name"
msgstr "Studnia"

msgid "building.well.desc"
msgstr "Daje wodę domom w swoim zasięgu. Zasięg liczy się długością drogi, więc drogi go powiększają."

msgid "building.farm.name"
msgstr "Farma zbożowa"

msgid "building.farm.desc"
msgstr "Rolnik orze, sieje i zbiera zboże z pól wokół farmy. Pola stawiasz osobno, do 16 kafli."

msgid "building.mill.name"
msgstr "Młyn"

msgid "building.mill.desc"
msgstr "Młynarz przynosi zboże z magazynu, miele je i odnosi worek mąki."

msgid "recipe.farming.name"
msgstr "Uprawa zboża"

msgid "recipe.farming.desc"
msgstr "Orka, siew, wzrost w trzech fazach, żniwa sierpem, wiązanie snopa i odniesienie go do magazynu."

msgid "recipe.milling.name"
msgstr "Mielenie"

msgid "recipe.milling.desc"
msgstr "Młynarz wsypuje zboże do kosza, śmigło się kręci, a z kamieni sypie się mąka."

msgid "recipe.baking.name"
msgstr "Pieczenie chleba"

msgid "recipe.baking.desc"
msgstr "Piekarz zagniata ciasto przy stole, wsadza je do pieca i wyjmuje kosz chleba."

msgid "terrain.grass.name"
msgstr "Trawa"

msgid "terrain.grass.desc"
msgstr "Zwykły teren. Można tu budować."

msgid "terrain.meadow.name"
msgstr "Łąka"

msgid "terrain.meadow.desc"
msgstr "Kwitnąca łąka. Można tu budować."

msgid "terrain.forest.name"
msgstr "Las"

msgid "terrain.forest.desc"
msgstr "Drzewa dla drwala. Chodzi się tu wolniej."

msgid "terrain.water.name"
msgstr "Rzeka"

msgid "terrain.water.desc"
msgstr "Woda. Nie da się jej przejść ani na niej budować."

msgid "terrain.ford.name"
msgstr "Bród"

msgid "terrain.ford.desc"
msgstr "Płytkie miejsce na rzece. Można je przejść, ale powoli."

msgid "terrain.stony.name"
msgstr "Kamienisty grunt"

msgid "terrain.stony.desc"
msgstr "Ziemia pełna kamieni. Można tu budować i kłaść drogi, ale pola tu nie urosną. Chodzi się trochę wolniej."

msgid "terrain.lake.name"
msgstr "Jezioro"

msgid "terrain.lake.desc"
msgstr "Spokojna woda. Wędkarz łowi tu ryby, a glinianka kopie glinę na brzegu."

msgid "need.food.name"
msgstr "Żywność"

msgid "need.food.desc"
msgstr "Chłopi jedzą chleb albo ryby ze spiżarni domu."

msgid "need.firewood.name"
msgstr "Opał"

msgid "need.firewood.desc"
msgstr "Drewno do palenia w piecu."

msgid "need.well_water.name"
msgstr "Woda"

msgid "need.well_water.desc"
msgstr "Dom musi być w zasięgu studni."

msgid "house_level.peasant_house.name"
msgstr "Chata"

msgid "house_level.peasant_house.desc"
msgstr "Poziom 1. Mieszka tu 4 chłopów."

msgid "house_level.burgher_house.name"
msgstr "Dom mieszczański"

msgid "house_level.burgher_house.desc"
msgstr "Poziom 2. Mieszka tu 8 mieszczan. Stojące obok siebie domy łączą się w pierzeję."

msgid "map.riverlands.name"
msgstr "Nadrzecze"

msgid "map.riverlands.desc"
msgstr "Kraina łąk i lasów przecięta rzeką z dwoma brodami."

msgid "map.lakeland.name"
msgstr "Pojezierze"

msgid "map.lakeland.desc"
msgstr "Duża kraina nad jeziorem: rzeka wpada do jeziora, na wzgórzu kamienisty grunt ze skałami, wokół lasy i łąki. Miejsce na wielkie miasto."

