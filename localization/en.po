msgid "recipe.forging_morning_stars.name"
msgstr "Forging morning stars"

msgid "recipe.forging_morning_stars.desc"
msgstr "1 iron → 1 morning star (about 45 s)."

msgid "recipe.crossbow_making.name"
msgstr "Making crossbows"

msgid "recipe.crossbow_making.desc"
msgstr "2 planks + 1 iron → 1 crossbow (about 34 s)."

msgid "unit.halberdier.name"
msgstr "Halberdier"

msgid "unit.halberdier.desc"
msgstr "A halberd and armour. 80 gold. Tough, two and a half times as deadly to riders."

msgid "unit.crossbowman.name"
msgstr "Crossbowman"

msgid "unit.crossbowman.desc"
msgstr "A crossbow. 50 gold. Shoots from 6 tiles, seldom but very hard; the bolt pierces armour."

msgid "unit.man_at_arms.name"
msgstr "Man-at-arms"

msgid "unit.man_at_arms.desc"
msgstr "A morning star and armour. 90 gold. The hardest blow and the most life, but slow."

msgid "unit.light_cavalry.name"
msgstr "Light cavalry"

msgid "unit.light_cavalry.desc"
msgstr "A horse and a spear. 60 gold. The fastest, cheaper and weaker than a rider; twice as deadly to archers and crossbowmen."

