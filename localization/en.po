# --- M4b-1: patricians, textiles, mead, bricks, tavern, forester, pause ---

msgid "good.wool.name"
msgstr "Wool"

msgid "good.wool.desc"
msgstr "Shorn from sheep at the sheep farm. The weaver spins it and weaves cloth."

msgid "good.cloth.name"
msgstr "Cloth"

msgid "good.cloth.desc"
msgstr "Woven from wool at the weaver. The tailor sews clothes from it."

msgid "good.clothes.name"
msgstr "Clothes"

msgid "good.clothes.desc"
msgstr "Sewn by the tailor. Patricians will not step outside without them."

msgid "good.honey.name"
msgstr "Honey"

msgid "good.honey.desc"
msgstr "Collected from the hives of the apiary. The mead maker turns it into mead."

msgid "good.mead.name"
msgstr "Mead"

msgid "good.mead.desc"
msgstr "The drink of patricians. The innkeeper serves it in the tavern too."

msgid "good.clay.name"
msgstr "Clay"

msgid "good.clay.desc"
msgstr "Dug by the water at the clay pit. The brickworks fires it into bricks."

msgid "good.bricks.name"
msgstr "Bricks"

msgid "good.bricks.desc"
msgstr "Fired from clay at the brickworks. Patrician townhouses are built from them."

msgid "building.forester.name"
msgstr "Forester"

msgid "building.forester.desc"
msgstr "The forester plants saplings nearby, stumps first. After a few minutes they grow into trees for the woodcutter."

msgid "building.sheep_farm.name"
msgstr "Sheep farm"

msgid "building.sheep_farm.desc"
msgstr "The shepherd tends the sheep in the pen, shears them and carries the wool away."

msgid "building.weaver.name"
msgstr "Weaver"

msgid "building.weaver.desc"
msgstr "The weaver brings wool, spins it at the wheel, weaves it on the loom and carries the cloth away."

msgid "building.tailor.name"
msgstr "Tailor"

msgid "building.tailor.desc"
msgstr "The tailor brings cloth, cuts it and sews clothes for the patricians."

msgid "building.apiary.name"
msgstr "Apiary"

msgid "building.apiary.desc"
msgstr "The beekeeper tends the hives, collects honey and carries it to storage."

msgid "building.meadery.name"
msgstr "Meadery"

msgid "building.meadery.desc"
msgstr "The mead maker brings honey, mixes it in the vat, ferments it in casks and carries the mead away."

msgid "building.clay_pit.name"
msgstr "Clay pit"

msgid "building.clay_pit.desc"
msgstr "The digger takes clay from the water's edge. Build it close to the river."

msgid "building.brickworks.name"
msgstr "Brickworks"

msgid "building.brickworks.desc"
msgstr "The brickmaker brings clay and wood, moulds bricks and fires them in the kiln."

msgid "building.tavern.name"
msgstr "Tavern"

msgid "building.tavern.desc"
msgstr "The innkeeper brings beer and mead and serves the guests. The tavern reaches houses only while it has drinks to pour."

msgid "recipe.planting.name"
msgstr "Planting trees"

msgid "recipe.planting.desc"
msgstr "The forester digs a hole, plants a sapling and goes back to rest."

msgid "recipe.sheep_farming.name"
msgstr "Sheep farming"

msgid "recipe.sheep_farming.desc"
msgstr "The shepherd herds the sheep, shears them and carries the wool away."

