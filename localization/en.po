# N1: quays and moorings

msgid "ui.build.pier"
msgstr "Pier"

msgid "ui.build.pier_tip"
msgstr "A timber pier on the sea: 2 planks a tile. Drag from the shore out to sea (at most 8 tiles), like a wall: straight or slanting, in 8 directions (a slant takes more tiles); it may also come up onto the land 2 tiles. Rows side by side join into one wide quay. People walk on it, ships cannot pass. Ports, shipyards, fishing wharves and moorings can stand on it."

msgid "ui.build.stone_quay"
msgstr "Quay"

msgid "ui.build.stone_quay_tip"
msgstr "A stone quay: 3 stones a tile. Works like a pier, but people walk on it faster, as on cobbles."

msgid "ui.doing.quay"
msgstr "to the quay"

msgid "building.mooring.name"
msgstr "Mooring"

msgid "building.mooring.desc"
msgstr "Bollards and ropes at the edge of the quay: one more ship can tie up here. No crew of its own: dockers of a port within 12 tiles carry the goods. Build it on a pier or quay, facing the water."

msgid "ui.command_error.not_on_quay"
msgstr "Only harbour buildings stand on a quay."

msgid "ui.command_error.needs_quay"
msgstr "This needs a quay or a pier under the building (only so many rows may stand on piles)."

msgid "ui.command_error.no_port_nearby"
msgstr "No port nearby (within 12 tiles) whose dockers would serve the ship."

msgid "ui.command_error.already_quay"
msgstr "There is a quay here already."

msgid "ui.command_error.keeps_fairway"
msgstr "Ships sail this way to deep water."

msgid "ui.command_error.keeps_berth"
msgstr "Ships moor here."

msgid "ui.command_error.too_far_from_shore"
msgstr "Too far from the shore (at most 8 tiles)."

msgid "ui.command_error.not_at_shore"
msgstr "A quay must start at the shore or at another quay."

msgid "ui.command_error.blocks_sea"
msgstr "This quay would cut a ship, a berth or a fish shoal off the sea."

msgid "ui.command_error.no_quay"
msgstr "There is no quay here."

msgid "ui.command_error.cuts_quay"
msgstr "The rest of the quay would lose its way to the shore."

msgid "ui.command_error.bad_quay"
msgstr "Unknown kind of quay."

msgid "ui.command_error.too_far_from_sea"
msgstr "Too far from the sea: a quay comes up onto the land at most 2 tiles."

# N1 part 2: the cargo crane and the port warehouse

msgid "building.crane.name"
msgstr "Harbour crane"

msgid "building.crane.desc"
msgstr "A wooden crane with a treadwheel. The crane operator walks in the wheel and lifts 3 goods at a time between the quay yard and the ship at the berth, beside the dockers, so ships load much faster. Build it on a quay at most 2 tiles from where a ship moors (by a port or a mooring)."

msgid "building.port_warehouse.name"
msgstr "Port warehouse"

msgid "building.port_warehouse.desc"
msgstr "A large warehouse on the quay, right by the ships: 8 slots for goods. No staff of its own: dockers and porters carry the goods. Ships at bollards are loaded from here. May stand 2 rows on piles over the water."

msgid "ui.kind.crane_operator"
msgstr "Crane operator"

msgid "ui.reason.no_berth"
msgstr "the crane stands by no berth"

msgid "ui.command_error.no_berth_nearby"
msgstr "A crane must stand at most 2 tiles from where a ship moors (by a port or a mooring)."

msgid "recipe.crane_work.name"
msgstr "Crane handling"

msgid "recipe.crane_work.desc"
msgstr "The crane operator walks in the treadwheel and lifts 3 goods at a time between the quay yard and the ship."

msgid "ui.crane.no_berth"
msgstr "It stands by no berth."

msgid "ui.crane.serves"
msgstr "Serves: %s"

msgid "ui.crane.no_ship"
msgstr "Waiting for a ship"

msgid "ui.crane.lifting"
msgstr "Lifting: %s"

msgid "ui.reason.no_ship"
msgstr "no ship at the berth"

msgid "ui.reason.no_cargo"
msgstr "nothing to lift"

# --- M7 part 1: metals, weapons, barracks ---

msgid "good.charcoal.name"
msgstr "Charcoal"

msgid "good.charcoal.desc"
msgstr "Light black lumps of burnt wood. It gives the heat a smelter needs."

msgid "good.iron_ore.name"
msgstr "Iron ore"

msgid "good.iron_ore.desc"
msgstr "Rusty lumps of rock hewn from an ore vein. A smelter turns them into iron."

msgid "good.iron.name"
msgstr "Iron"

msgid "good.iron.desc"
msgstr "Iron bars from the smelter. The blacksmith forges weapons from them, the armourer armour."

msgid "good.spear.name"
msgstr "Spear"

msgid "good.spear.desc"
msgstr "A long shaft with an iron head. The spearman's weapon, deadly to riders."

msgid "good.bow.name"
msgstr "Bow"

msgid "good.bow.desc"
msgstr "A bow of supple wood, strung. The archer's weapon."

msgid "good.sword.name"
msgstr "Sword"

msgid "good.sword.desc"
msgstr "A straight iron sword. The weapon of swordsmen and riders."

msgid "good.chainmail.name"
msgstr "Armour"

msgid "good.chainmail.desc"
msgstr "Iron armour: mail with plates on the chest and shoulders. It protects swordsmen, riders, halberdiers and heavy men-at-arms."

msgid "good.horse.name"
msgstr "Horse"

msgid "good.horse.desc"
msgstr "A riding horse from a stud farm. No rider without one."

msgid "building.charcoal_burner.name"
msgstr "Charcoal burner"

msgid "building.charcoal_burner.desc"
msgstr "The charcoal burner stacks wood into a kiln, covers it with turf and burns it slowly. 2 wood make a sack of charcoal."

msgid "building.mine.name"
msgstr "Iron mine"

msgid "building.mine.desc"
msgstr "The miner hews iron ore out of a nearby vein and carries it to storage. Build it by an ore vein in the rocks."

msgid "building.smelter.name"
msgstr "Smelter"

msgid "building.smelter.desc"
msgstr "The smelter fills the furnace with ore and charcoal, works the bellows and taps a bar of iron."

msgid "building.blacksmith.name"
msgstr "Blacksmith"

msgid "building.blacksmith.desc"
msgstr "The blacksmith heats iron in the forge and hammers it on the anvil: iron and a plank make 2 spears, iron alone a sword. Choose in the panel what he makes."

msgid "building.armourer.name"
msgstr "Armourer"

msgid "building.armourer.desc"
msgstr "The armourer makes armour from 2 iron bars: linked rings and riveted plates."

msgid "building.bowyer.name"
msgstr "Bowyer"

msgid "building.bowyer.desc"
msgstr "The bowyer carves a bow stave from 2 planks, bends it and strings it."

msgid "building.stud_farm.name"
msgstr "Stud farm"

msgid "building.stud_farm.desc"
msgstr "The groom feeds and brushes the horses, and the herd grows by itself. It starts with a pair. Only in a province with horse pastures."

msgid "building.armoury.name"
msgstr "Armoury"

msgid "building.armoury.desc"
msgstr "All weapons and armour are kept here. Recruits come here for their gear."

msgid "building.barracks.name"
msgstr "Barracks"

msgid "building.barracks.desc"
msgstr "Home of soldiers: 24 beds. Recruit your army here. Soldiers eat from storage and drill in front of the barracks."

msgid "recipe.charcoal_making.name"
msgstr "Charcoal burning"

msgid "recipe.charcoal_making.desc"
msgstr "2 wood → 1 charcoal (about 40 s)."

msgid "recipe.mining.name"
msgstr "Mining"

msgid "recipe.mining.desc"
msgstr "The miner hews 1 ore from the vein (about 45 s with the walk)."

msgid "recipe.smelting.name"
msgstr "Smelting"

msgid "recipe.smelting.desc"
msgstr "1 ore + 1 charcoal → 1 iron (about 40 s)."

msgid "recipe.forging_spears.name"
msgstr "Forging spears"

msgid "recipe.forging_spears.desc"
msgstr "1 iron + 1 plank → 2 spears (about 45 s)."

msgid "recipe.forging_swords.name"
