msgid "good.crossbow.name"
msgstr "Crossbow"

msgid "good.crossbow.desc"
msgstr "A steel bow on a wooden stock. It shoots less often than a bow, but its bolt pierces armour."

msgid "good.morning_star.name"
msgstr "Morning star"

msgid "good.morning_star.desc"
msgstr "An oak club with a spiked iron ball. The heavy man-at-arms' weapon."

