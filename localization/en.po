msgstr "The quick brown fox jumps over the lazy dog"

# --- Goods ---

msgid "good.wood.name"
msgstr "Wood"

msgid "good.wood.desc"
msgstr "Logs from the forest. Basic building material and fuel."

msgid "good.wood.count"
msgid_plural "good.wood.count_plural"
msgstr[0] "%s log"
msgstr[1] "%s logs"

msgid "good.grain.name"
msgstr "Grain"

msgid "good.grain.desc"
msgstr "Sheaves of grain from the fields. The mill grinds them into flour."

msgid "good.grain.count"
msgid_plural "good.grain.count_plural"
msgstr[0] "%s sheaf"
msgstr[1] "%s sheaves"

msgid "good.flour.name"
msgstr "Flour"

msgid "good.flour.desc"
msgstr "Sacks of flour from the mill. The baker turns it into bread."

msgid "good.flour.count"
msgid_plural "good.flour.count_plural"
msgstr[0] "%s sack of flour"
msgstr[1] "%s sacks of flour"

msgid "good.bread.name"
msgstr "Bread"

msgid "good.bread.desc"
msgstr "Fresh bread from the bakery. Staple food of your people."

msgid "good.bread.count"
msgid_plural "good.bread.count_plural"
msgstr[0] "%s loaf"
msgstr[1] "%s loaves"

# --- Buildings ---

msgid "building.woodcutter.name"
msgstr "Woodcutter"

msgid "building.woodcutter.desc"
msgstr "The woodcutter fells nearby trees and carries the logs to the warehouse."

msgid "building.bakery.name"
msgstr "Bakery"

msgid "building.bakery.desc"
msgstr "The baker fetches flour, kneads the dough and bakes bread in the oven."

msgid "building.stockpile.name"
msgstr "Stockpile"

msgid "building.stockpile.desc"
msgstr "A storage yard. Goods lie here in stacks; porters bring them in and take them out."

# --- Recipes ---

msgid "recipe.woodcutting.name"
msgstr "Woodcutting"

msgid "recipe.woodcutting.desc"
msgstr "The woodcutter walks to a tree, chops it, binds a log and carries it to the stockpile."

# --- Resource nodes ---

msgid "resource_node.tree.name"
msgstr "Tree"

msgid "resource_node.tree.desc"
msgstr "Gives a few logs of wood. A stump is left once it is cut down."

# --- UI: stockpile panel ---

msgid "ui.stockpile.title"
msgstr "Stockpile"

msgid "ui.stockpile.empty"
msgstr "Empty"

# --- M3: buildings, terrain, needs, houses ---

msgid "building.town_hall.name"
msgstr "Town hall"

msgid "building.town_hall.desc"
msgstr "The heart of the settlement. Porters and the builder work from here, carrying goods and raising buildings."

msgid "building.hut.name"
msgstr "Hut"

msgid "building.hut.desc"
msgstr "Home for 4 peasants. Supplied with bread, wood and well water, it grows into a burgher house."

msgid "building.well.name"
msgstr "Well"

msgid "building.well.desc"
msgstr "Gives water to houses within reach. Reach is measured along paths, so roads extend it."

msgid "building.farm.name"
msgstr "Grain farm"

msgid "building.farm.desc"
msgstr "The farmer ploughs, sows and harvests grain on the fields around the farm. Place up to 16 field tiles separately."

msgid "building.mill.name"
msgstr "Mill"

msgid "building.mill.desc"
msgstr "The miller brings grain from the storage, grinds it and carries back a sack of flour."

msgid "recipe.farming.name"
msgstr "Grain farming"

msgid "recipe.farming.desc"
msgstr "Ploughing, sowing, three growth stages, reaping with a sickle, binding a sheaf and carrying it to the storage."

msgid "recipe.milling.name"
msgstr "Milling"

msgid "recipe.milling.desc"
msgstr "The miller pours grain into the hopper, the sails turn and flour pours from the stones."

msgid "recipe.baking.name"
msgstr "Baking"

msgid "recipe.baking.desc"
msgstr "The baker kneads dough at the table, puts it in the oven and takes out a basket of bread."

msgid "terrain.grass.name"
msgstr "Grass"

msgid "terrain.grass.desc"
msgstr "Ordinary ground. You can build here."

msgid "terrain.meadow.name"
msgstr "Meadow"

msgid "terrain.meadow.desc"
msgstr "A flowering meadow. You can build here."

msgid "terrain.forest.name"
msgstr "Forest"

msgid "terrain.forest.desc"
msgstr "Trees for the woodcutter. Walking here is slower."

msgid "terrain.water.name"
msgstr "River"

msgid "terrain.water.desc"
msgstr "Water. It cannot be crossed or built on."

msgid "terrain.ford.name"
msgstr "Ford"

msgid "terrain.ford.desc"
msgstr "A shallow place in the river. It can be crossed, but slowly."

msgid "need.food.name"
msgstr "Food"

msgid "need.food.desc"
msgstr "Peasants eat bread or fish from the house pantry."

msgid "need.firewood.name"
msgstr "Firewood"

msgid "need.firewood.desc"
msgstr "Wood to burn in the stove."

msgid "need.well_water.name"
msgstr "Water"

msgid "need.well_water.desc"
msgstr "The house must be within reach of a well."

msgid "house_level.peasant_house.name"
msgstr "Hut"

msgid "house_level.peasant_house.desc"
msgstr "Level 1. Home for 4 peasants."

msgid "house_level.burgher_house.name"
msgstr "Burgher house"

msgid "house_level.burgher_house.desc"
msgstr "Level 2. Home for 8 burghers. Houses side by side join into a row."

msgid "map.riverlands.name"
msgstr "Riverlands"

msgid "map.riverlands.desc"
msgstr "A land of meadows and forests cut by a river with two fords."

