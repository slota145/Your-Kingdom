# B1: bridges

msgid "ui.build.bridge"
msgstr "Bridge"

msgid "ui.build.bridge_tip"
msgstr "Timber bridge over a river, ford or lake: 3 planks a tile. Drag from one bank to the other (at most 8 tiles of water), straight or slanting in 8 directions (a slant takes more tiles). People walk on it like on a road, and handcarts and wagons drive over it. A builder lays it from the nearer bank."

msgid "ui.build.stone_bridge"
msgstr "Stone bridge"

msgid "ui.build.stone_bridge_tip"
msgstr "Stone bridge with arches: 4 stones a tile. Works like the timber one, but people walk on it faster, as on cobbles."

msgid "ui.doing.bridge"
msgstr "to the bridge"

msgid "ui.command_error.no_water"
msgstr "A bridge goes over a river, ford or lake."

msgid "ui.command_error.not_water"
msgstr "No water for a bridge here."

msgid "ui.command_error.bridge_needs_bank"
msgstr "Start the bridge on the bank, on free land."

msgid "ui.command_error.bridge_needs_far_bank"
msgstr "The bridge must reach the other bank (free land)."

msgid "ui.command_error.bridge_too_long"
msgstr "Bridge too long: at most 8 tiles of water."

msgid "ui.command_error.already_bridge"
msgstr "A bridge stands here already."

msgid "ui.command_error.no_bridge"
msgstr "No bridge here."

msgid "ui.command_error.bad_bridge"
msgstr "Unknown kind of bridge."

