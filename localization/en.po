msgid "recipe.sawing.name"
msgstr "Sawing"

msgid "recipe.sawing.desc"
msgstr "The sawyer lays a log on the trestle and saws it into planks."

msgid "recipe.quarrying.name"
msgstr "Quarrying"

msgid "recipe.quarrying.desc"
msgstr "The stonecutter breaks a block off the rock, shapes it and carries it to the stockpile."

msgid "recipe.fishing.name"
msgstr "Angling"

msgid "recipe.fishing.desc"
msgstr "The angler casts twice, waits for a bite and reels in a fish, then carries the basket."

msgid "recipe.hop_farming.name"
msgstr "Hop growing"

msgid "recipe.hop_farming.desc"
msgstr "The hop grower ploughs, plants, and picks the ripe hops from the poles."

msgid "recipe.brewing.name"
msgstr "Brewing"

msgid "recipe.brewing.desc"
msgstr "The brewer mashes grain in the vat, brews it with hops in the kettle and carries out the barrels."

