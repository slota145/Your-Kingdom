# --- M4a ---

msgid "good.planks.name"
msgstr "Planks"

msgid "good.planks.desc"
msgstr "Planks from the sawmill. Needed to upgrade huts and for larger buildings."

msgid "good.stone.name"
msgstr "Stone"

msgid "good.stone.desc"
msgstr "Hewn stone from the quarry. Used for the church and the brewery."

msgid "good.fish.name"
msgstr "Fish"

msgid "good.fish.desc"
msgstr "Fish caught with a rod in the river. Peasants and burghers eat them."

msgid "good.hops.name"
msgstr "Hops"

msgid "good.hops.desc"
msgstr "Hop cones from the hop garden. No beer without them."

msgid "good.beer.name"
msgstr "Beer"

msgid "good.beer.desc"
msgstr "Beer from the brewery, brewed from grain and hops. Burghers cannot do without it."

msgid "building.sawmill.name"
msgstr "Sawmill"

msgid "building.sawmill.desc"
msgstr "The sawyer brings a log from the stockpile, saws it into planks and takes them back."

msgid "building.quarry.name"
msgstr "Quarry"

msgid "building.quarry.desc"
msgstr "The stonecutter breaks stone off nearby rocks and takes it to the stockpile."

msgid "building.fishing_hut.name"
msgstr "Angler's hut"

msgid "building.fishing_hut.desc"
msgstr "The angler goes to the water, casts the rod and waits for a bite. Build it near the river."

msgid "building.hop_farm.name"
msgstr "Hop farm"

msgid "building.hop_farm.desc"
msgstr "The hop grower tends hops on fields around the farmstead. You place the fields, as with a farm."

msgid "building.brewery.name"
msgstr "Brewery"

msgid "building.brewery.desc"
msgstr "The brewer brings grain and hops, mashes, brews and takes barrels of beer to the stockpile."

msgid "building.chapel.name"
msgstr "Chapel"

msgid "building.chapel.desc"
msgstr "A small chapel. Peasants within its reach are happier."

msgid "building.church.name"
msgstr "Church"

msgid "building.church.desc"
msgstr "A stone church with a tower. Burghers within its reach are happier."

msgid "building.market.name"
msgstr "Market"

msgid "building.market.desc"
msgstr "A square with stalls. Stallholders bring food, drink, clothes and firewood from storages; households within reach buy there and are happier. The travelling merchant stops here."

msgid "resource_node.rock.name"
msgstr "Rock"

msgid "resource_node.rock.desc"
msgstr "A rock outcrop. The stonecutter breaks stone off it until only rubble is left."

msgid "need.bread.name"
msgstr "Bread"

msgid "need.bread.desc"
msgstr "Burghers want bread every day."

msgid "need.fish_or_meat.name"
msgstr "Fish or meat"

msgid "need.fish_or_meat.desc"
msgstr "Burghers also want fish (meat comes later)."

msgid "need.beer.name"
msgstr "Beer"

msgid "need.beer.desc"
msgstr "Burghers drink beer from the brewery."

msgid "need.chapel.name"
msgstr "Chapel"

msgid "need.chapel.desc"
msgstr "An extra need of peasants: a chapel in reach. Adds happiness, does not block upgrades."

msgid "need.church.name"
msgstr "Church"

msgid "need.church.desc"
msgstr "An extra need of burghers: a church in reach."

msgid "need.market.name"
msgstr "Market"

msgid "need.market.desc"
msgstr "An extra need of burghers: a market in reach."

