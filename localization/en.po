msgid "ui.kind.light_cavalry"
msgstr "Light horseman"

# J1 part 2: ballista

msgid "unit.ballista.name"
msgstr "Ballista"

msgid "unit.ballista.desc"
msgstr "A great crossbow on wheels: it shoots a heavy bolt 10 tiles. It kills men and badly hurts rams and other ballistas; walls and gates only a little. A crew of 2, slow."

msgid "ui.kind.ballista"
msgstr "Ballista"

# J1 part 3: the large shipyard and its ships

msgid "building.large_shipyard.name"
msgstr "Large shipyard"

msgid "building.large_shipyard.desc"
msgstr "A great slipway three rows into the water, a shed on a stone base and two cranes. Builds caravels, carracks and galleons, for trade and for war. 2 shipwrights work here. Needs a straight shore 6 tiles long and deep water before the slipway."

msgid "ship.caravel.name"
msgstr "Caravel"

msgid "ship.caravel.desc"
msgstr "Light and the fastest: three masts, a triangular lateen sail aft. A hold of 6 slots, voyages and routes like the cog. Cost: 30 planks, 8 barrels of tar, 8 bolts of cloth."

msgid "ship.caravel_war.name"
msgstr "War caravel"

msgid "ship.caravel_war.desc"
msgstr "A caravel with shields along her sides: carries 40 soldiers, stronger at sea than the war cog. Cost: 36 planks, 10 barrels of tar, 8 bolts of cloth, 4 iron."

msgid "ship.carrack.name"
msgstr "Carrack"

msgid "ship.carrack.desc"
msgstr "A round ship with tall castles fore and aft, two sails on her front masts. A hold of 9 slots. Cost: 48 planks, 12 barrels of tar, 12 bolts of cloth, 4 iron."

msgid "ship.carrack_war.name"
msgstr "War carrack"

msgid "ship.carrack_war.desc"
msgstr "A carrack with shields: carries 60 soldiers, a strong hull and many bolts. Cost: 54 planks, 14 barrels of tar, 12 bolts of cloth, 8 iron."

msgid "ship.galleon.name"
msgstr "Galleon"

msgid "ship.galleon.desc"
msgstr "The biggest: four masts, three sails on the front ones, a tall stern castle, ports along her sides. A hold of 12 slots. Cost: 70 planks, 18 barrels of tar, 18 bolts of cloth, 6 iron."

msgid "ship.galleon_war.name"
msgstr "War galleon"

msgid "ship.galleon_war.desc"
msgstr "A galleon with shields: carries 90 soldiers, the strongest at sea. Cost: 78 planks, 20 barrels of tar, 18 bolts of cloth, 12 iron."

# P2 part 1: bollards, port warehouses, dockers

msgid "building.bollard.name"
msgstr "Bollard"

msgid "building.bollard.desc"
msgstr "A stone bollard on the edge of a stone quay: a ship moors here to trade, unload or load goods. It has no yard of its own: the goods go to the nearest port warehouse (within 12 tiles), or without one straight to the ordinary storages, carried by the dockers of a port, hut or house nearby. People walk past it along the quay."

msgid "building.port_store.name"
msgstr "Port store"

msgid "building.port_store.desc"
msgstr "A small wooden shed on the quay: 2 slots for goods. No staff of its own: dockers and porters carry the goods."

msgid "building.port_warehouse_small.name"
msgstr "Small port warehouse"

msgid "building.port_warehouse_small.desc"
msgstr "A warehouse on the quay: 4 slots for goods. No staff of its own: dockers and porters carry the goods. May stand one row on piles over the water."

msgid "building.docker_hut.name"
msgstr "Dockers' hut"

msgid "building.docker_hut.desc"
msgstr "A small hut of 2 dockers. They load and unload ships at the port, moorings and bollards within 12 tiles by themselves and carry goods between the quay and the port warehouses. Two doors: landward and seaward."

msgid "building.docker_house.name"
msgstr "Dockers' house"

